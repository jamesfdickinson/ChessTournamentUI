{
  "name": "chess-tournament",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "serve": "SET NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service serve",
    "build": "SET NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build",
    "lint": "SET NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service lint",
    "build-dev": "SET NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build --mode development",
    "build-cordova": "SET NODE_OPTIONS=--openssl-legacy-provider && cross-env CORDOVA_PLATFORM=ios vue-cli-service build --dest src-cordova/www/",
    "serve-cordova": "SET NODE_OPTIONS=--openssl-legacy-provider && cross-env CORDOVA_PLATFORM=ios vue-cli-service serve"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^19.0.0",
    "@ckeditor/ckeditor5-vue": "^1.0.1",
    "@ionic/core": "^4.7.4",
    "@ionic/vue": "0.0.1",
    "@microsoft/signalr": "^5.0.6",
    "@widgetbot/embed-api": "^1.1.3",
    "axios": "^0.19.0",
    "howler": "^2.2.1",
    "jsondiffpatch": "^0.4.1",
    "vue": "^2.7.15",
    "vue-json-csv": "^1.2.5",
    "vue-router": "^3.1.2",
    "vue-simple-alert": "^1.1.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^3.10.0",
    "@vue/cli-plugin-eslint": "^3.10.0",
    "@vue/cli-service": "^3.10.0",
    "babel-eslint": "^10.0.2",
    "cross-env": "^7.0.0",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.2.3",
    "vue-template-compiler": "^2.7.15"
  }
}
